# Firebase Admin SDK（後端用，憑證 JSON 路徑，請勿 commit JSON 檔案）
FIREBASE_SERVICE_ACCOUNT_PATH=./your-firebase-adminsdk-xxxxx.json

# Cloudinary
CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret

# Server
PORT=3001

# Postgres（Supabase）— Project Settings → Database → Connection string
# 建議用 Connection pooling 那組（pgbouncer），Prisma migrate 才需要 direct connection
DATABASE_URL=postgresql://postgres:your-password@your-project.supabase.co:5432/postgres

# Firebase 前端設定（Vite 用）
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
